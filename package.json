{
  "name": "pnote",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run build -w apps/web",
    "e2e": "playwright test -c apps/web",
    "check:no-external": "node scripts/check-no-external.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "vitest-canvas-mock": "^1.2.0"
  }
}
